<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:padding="6dp">

    <!-- 顶部：统计 + 更多。都放在 wrap_content 行里，不参与权重分配 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:text="@string/home_total"
                android:textColor="@color/text_dim"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvStat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="6dp"
                android:paddingBottom="2dp"
                android:text="@string/home_stat"
                android:textColor="@color/text"
                android:textSize="19sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnMore"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_btn"
            android:gravity="center"
            android:minWidth="72dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/btn_more"
            android:textColor="@color/text"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 剩余空间全部给 2x2 按钮区 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnIntake"
                style="@style/BigButton"
                android:backgroundTint="@color/green"
                android:text="@string/btn_intake" />

            <TextView
                android:id="@+id/btnBorrow"
                style="@style/BigButton"
                android:backgroundTint="@color/blue"
                android:text="@string/btn_borrow" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnReturn"
                style="@style/BigButton"
                android:backgroundTint="@color/orange"
                android:text="@string/btn_return" />

            <TextView
                android:id="@+id/btnSearch"
                style="@style/BigButton"
                android:backgroundTint="@color/surface_2"
                android:text="@string/btn_search" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
