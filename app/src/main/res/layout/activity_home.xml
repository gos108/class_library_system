<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:padding="6dp">

    <TextView
        android:id="@+id/tvTotal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="6dp"
        android:paddingTop="4dp"
        android:text="@string/home_total"
        android:textColor="@color/text_dim"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/tvStat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="6dp"
        android:paddingBottom="4dp"
        android:text="@string/home_stat"
        android:textColor="@color/text"
        android:textSize="19sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnIntake"
            style="@style/BigButton"
            android:backgroundTint="@color/green"
            android:text="@string/btn_intake" />

        <TextView
            android:id="@+id/btnBorrow"
            style="@style/BigButton"
            android:backgroundTint="@color/blue"
            android:text="@string/btn_borrow" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnReturn"
            style="@style/BigButton"
            android:backgroundTint="@color/orange"
            android:text="@string/btn_return" />

        <TextView
            android:id="@+id/btnSearch"
            style="@style/BigButton"
            android:backgroundTint="@color/surface_2"
            android:text="@string/btn_search" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnMore"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center"
        android:text="@string/btn_more"
        android:textColor="@color/text_dim"
        android:textSize="14sp" />

</LinearLayout>
