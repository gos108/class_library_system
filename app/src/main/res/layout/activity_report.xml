<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/tvState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="正在准备报表…"
            android:textColor="@color/text"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/tvStep1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="① 扫码连这个 WiFi"
            android:textColor="@color/text_dim"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/ivWifiQr"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:background="@color/text"
            android:contentDescription="WiFi 二维码"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/tvWifi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvStep2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="② 扫码下载 Excel"
            android:textColor="@color/text_dim"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/ivUrlQr"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:background="@color/text"
            android:contentDescription="下载二维码"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/tvUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvTip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnRefresh"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_btn"
            android:gravity="center"
            android:text="刷新地址"
            android:textColor="@color/text"
            android:textSize="16sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnStop"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_btn"
            android:backgroundTint="@color/surface_2"
            android:gravity="center"
            android:text="停止服务"
            android:textColor="@color/text"
            android:textSize="17sp" />

    </LinearLayout>
</ScrollView>
