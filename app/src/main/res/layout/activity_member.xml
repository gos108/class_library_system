<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/title_member"
        android:textColor="@color/text"
        android:textSize="20sp" />

    <EditText
        android:id="@+id/etPaste"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/surface"
        android:gravity="top|start"
        android:hint="@string/hint_paste_names"
        android:inputType="textMultiLine"
        android:padding="8dp"
        android:textColor="@color/text"
        android:textColorHint="@color/text_dim"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/btnImport"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_btn"
        android:backgroundTint="@color/green"
        android:gravity="center"
        android:text="@string/btn_import"
        android:textColor="@color/text"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/tvCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="6dp"
        android:textColor="@color/text_dim"
        android:textSize="14sp" />

    <ListView
        android:id="@+id/lvMembers"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2" />

</LinearLayout>
